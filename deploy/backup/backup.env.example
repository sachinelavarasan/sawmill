# Backup settings → /etc/sawmill/backup.env (chmod 600, owner sawmill)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sawmill
DB_USER=sawmill
DB_PASSWORD=

BACKUP_DIR=/var/backups/sawmill
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# Off-site copy (strongly recommended). Set up the remote once with: rclone config
# RCLONE_REMOTE=gdrive:sawmill-backups
# Encrypt the off-site copy to this GPG public key (import it first: gpg --import owner.pub)
# GPG_RECIPIENT=owner@example.in
