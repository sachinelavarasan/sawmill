# Production settings for the API → /etc/sawmill/api.env (read by systemd).
#   sudo install -m 600 -o sawmill -g sawmill deploy/api.env.example /etc/sawmill/api.env
# The API refuses to start if a value below is missing or still an example.
# systemd does not allow comments after a value — keep comments on their own lines.

NODE_ENV=production

# Only nginx on this server talks to the API.
HOST=127.0.0.1
PORT=3000
# One proxy hop (nginx): gives the API the real visitor address.
TRUST_PROXY=1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sawmill
DB_USER=sawmill
# openssl rand -base64 24
DB_PASSWORD=
DB_POOL_MAX=10

# openssl rand -base64 48   (never reuse the development value)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# The web address people open, exactly (https, no trailing slash).
CORS_ORIGINS=https://mill.example.in

# Do NOT set SEED_* values here. Create the owner with: npm run setup:owner
