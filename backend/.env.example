NODE_ENV="development"
PORT=3000

# Database — either DATABASE_URL or the DB_* values below
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sawmill
DB_USER=postgres
DB_PASSWORD=change-me
# DATABASE_URL="postgresql://user:password@localhost:5432/sawmill"

# Generate strong values for production: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of allowed web origins
CORS_ORIGINS="http://localhost:5173"

# Seed accounts (development only)
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=Owner@123
SEED_ACCOUNTANT_USERNAME=accountant
SEED_ACCOUNTANT_PASSWORD=Accountant@123
