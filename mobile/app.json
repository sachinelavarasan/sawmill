{
  "expo": {
    "name": "TimberTrail",
    "slug": "sawmill-pro",
    "scheme": "timbertrail",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8FAFC",
    "android": {
      "package": "com.sawmillpro.app",
      "adaptiveIcon": {
        "backgroundColor": "#1e293b"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-dark.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#1E293B",
          "dark": {
            "image": "./assets/icon-dark.png",
            "backgroundColor": "#0F172A"
          }
        }
      ]
    ]
  }
}
