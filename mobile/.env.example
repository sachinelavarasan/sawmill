# Copy to .env (git-ignored). Required — the app stops with a clear error if it is missing.
# After changing it, restart Metro with a clean cache: npx expo start -c
#
# The API root, including /api (backend PORT, default 3000):
#   Android emulator → your computer:  http://10.0.2.2:3000/api
#   Real phone on the same Wi-Fi:      http://<your computer's LAN IP>:3000/api
#   Server:                            https://mill.example.in/api
# EAS builds take it from the profile's "env" in eas.json instead.
EXPO_PUBLIC_API_URL=http://10.232.171.92:3000/api

# Push notifications: the EAS project id from `npx eas init` (also add it to each profile's
# "env" in eas.json). Without it the app still runs; only remote push is off.
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
